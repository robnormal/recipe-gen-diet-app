{
  "name": "backend",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --env-file=.env ../node_modules/.bin/jest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "import-foods": "tsx --env-file=.env src/import-foods.ts"
  },
  "dependencies": {
    "bcryptjs": "*",
    "connect-pg-simple": "*",
    "cors": "*",
    "express": "*",
    "express-session": "*",
    "openai": "*",
    "pg": "*"
  },
  "devDependencies": {
    "@eslint/js": "*",
    "@types/bcryptjs": "*",
    "@types/connect-pg-simple": "*",
    "@types/cors": "*",
    "@types/express": "*",
    "@types/express-session": "*",
    "@types/jest": "*",
    "@types/node": "*",
    "@types/pg": "*",
    "@types/supertest": "*",
    "@typescript-eslint/eslint-plugin": "*",
    "@typescript-eslint/parser": "*",
    "eslint": "*",
    "globals": "*",
    "jest": "*",
    "supertest": "*",
    "ts-jest": "*",
    "tsx": "*",
    "typescript": "*",
    "typescript-eslint": "*"
  }
}
